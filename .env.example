# Set these as Cloudflare Pages production secrets/variables; never commit real values.
GEMINI_API_KEY=

# EmailJS REST notifications (same template is sent twice: clinic and patient).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
CLINIC_EMAIL=
CLINIC_ASSISTANT_EMAIL=

# Google Sheets: Apps Script Web App endpoint and the matching shared token.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# Stripe Checkout: fixed ₹100 appointment fee and signed payment webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL for the clinic-owned PhonePe/UPI QR image shown in paid emails.
CLINIC_PAYMENT_QR_URL=
