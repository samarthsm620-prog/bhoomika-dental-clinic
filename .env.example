# Set these as Cloudflare Pages production secrets/variables; never commit real values.
GEMINI_API_KEY=

# EmailJS appointment notifications.
# Service/template IDs are documented in functions/api/appointment.js.
EMAILJS_PUBLIC_KEY=
CLINIC_EMAIL=
CLINIC_ASSISTANT_EMAIL=

# Public URL for the clinic-owned PhonePe QR shown on the site and in email.
CLINIC_PAYMENT_QR_URL=https://bhoomika-dental-clinic.pages.dev/images/payment/phonepe-appointment-qr.jpeg
