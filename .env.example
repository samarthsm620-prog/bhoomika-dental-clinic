# Configure these in Cloudflare Pages, never commit real values.
GEMINI_API_KEY=

# EmailJS REST integration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
CLINIC_EMAIL=

# Google Sheets: deploy a clinic-owned Google Apps Script web app that
# validates GOOGLE_SHEETS_SHARED_SECRET and appends the JSON fields to a sheet.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SHARED_SECRET=

# Optional override; the existing Manus webhook is used if omitted.
MANUS_APPOINTMENT_WEBHOOK=

# Custom domain is configured in Cloudflare Pages/DNS, not as a secret.
# CUSTOM_DOMAIN=
