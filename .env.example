# Set these as Cloudflare Pages production secrets/variables; never commit real values.
GEMINI_API_KEY=

# EmailJS appointment notifications.
# Service/template IDs are documented in functions/api/appointment.js.
EMAILJS_PUBLIC_KEY=
CLINIC_EMAIL=
CLINIC_ASSISTANT_EMAIL=

# Public URL for the clinic-owned PhonePe QR shown on the site and in email.
CLINIC_PAYMENT_QR_URL=https://bhoomika-dental-clinic.pages.dev/images/payment/phonepe-appointment-qr.jpeg

# EmailJS private key (Account > API keys). Needed for server-side sends.
EMAILJS_PRIVATE_KEY=

# Stripe ₹100 appointment payment + webhook (endpoint: /api/stripe-webhook, event: checkout.session.completed).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Callback routing URL; keep the webhook URL server-side as a Pages Function secret.
MANUS_CALLBACK_WEBHOOK=

# Booking workflow state + signed doctor links
WORKFLOW_SECRET=
SHEETS_WEBAPP_URL=
SHEETS_TOKEN=
